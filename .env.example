# Standalone fixture runner: no Brisky engine, Google key, Docker or database.
# Copy to .env and provide a server-only Meta API key for live model responses.
META_API_KEY=
DEMO_PORT=3100
DEMO_CHAT_MODEL=muse-wonder-1.0
DEMO_ENGINE_MODE=fixtures
# Fixtures are synthetic indexed observations, not a real connected media archive.
# Requests are opt-in through the UI. No indexing/connector background jobs run.
AI_BUDGET_USD=3
AI_USAGE_LEDGER_PATH=storage/usage/ai-attempts.jsonl
AI_MODEL_PRICING_JSON='{"meta/muse-wonder-1.0":{"reservationUsd":0.25,"inputUsdPerMillion":4,"outputUsdPerMillion":20},"meta/muse-spark-1.3":{"reservationUsd":0.25,"inputUsdPerMillion":1.25,"outputUsdPerMillion":4.25},"meta-asr/muse-voice-transcribe-1.0":{"reservationUsd":0.05,"inputUsdPerMillion":0,"outputUsdPerMillion":0}}'
# Optional microphone voice uses Meta ASR -> Meta dialogue -> local Meta MMS.
DEMO_VOICE_ENABLED=false
META_VOICE_MODEL=muse-wonder-1.0
MMS_MODEL_DIR=storage/mms-models/eng
MMS_CPU_THREADS=4
