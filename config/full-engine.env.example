# Judge-only engine configuration. Copy to .engine/.env; never commit filled credentials.
# Use your own keys. See docs/FULL-SETUP.md.
PORT=3001
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brisky
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=REPLACE_WITH_FIRST_RANDOM_VALUE
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_SECOND_RANDOM_VALUE

META_API_KEY=REPLACE_WITH_YOUR_META_KEY
META_ONLY_RUNTIME=true
AI_PROVIDER=meta
EMBEDDING_PROVIDER=meta-local
TRANSCRIPTION_PROVIDER=ai
META_MODEL=muse-spark-1.3
META_VIDEO_MODEL=muse-spark-1.2
META_AUDIO_MODEL=muse-spark-1.2
META_VOICE_MODEL=muse-wonder-1.0
META_FALLBACK_MODELS=
META_VIDEO_FALLBACK_MODELS=
META_AUDIO_FALLBACK_MODELS=
FACE_RECOGNITION_ENABLED=false
FACE_ARCHIVE_WORKER_ENABLED=false
SPACE_REPLIES_ENABLED=true

VOICE_ENABLED=true
VOICE_CONVERSATION_MODE=meta-mms
VOICE_LIVE_PUBLIC_URL=ws://localhost:3001/api/v1/saas-engine/voice/live
VOICE_LIVE_APP_ORIGIN=http://localhost:3000
MMS_MODEL_DIR=storage/mms-models/eng
META_EMBEDDING_MODEL_DIR=storage/meta-embeddings

GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_OAUTH_CLIENT_SECRET
GOOGLE_SAAS_REDIRECT_URI=http://localhost:3000/api/connectors/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google-drive/callback
ENABLE_CONNECTOR_POLLING=false
RUN_WORKER_IN_API=false
SAAS_DRIVE_SYNC_ENABLED=true
SAAS_DRIVE_SYNC_ACCOUNT_IDS=
INDEX_ALLOWED_CONNECTOR_ACCOUNT_IDS=
INDEX_BUDGET_PLAN_ENABLED=true
INDEX_PLAN_ATTEMPTS_PER_CALL=2
WORKER_FULL_DOWNLOAD_MAX_MB=16384
INDEX_RANGE_MAX_MB=16384

AI_BUDGET_USD=5
AI_USAGE_LEDGER_PATH=./storage/usage/ai-attempts.jsonl
AI_MODEL_PRICING_JSON='{"meta/muse-spark-1.3":{"reservationUsd":0.25,"inputUsdPerMillion":1.25,"outputUsdPerMillion":4.25},"meta/muse-spark-1.2":{"reservationUsd":0.25,"inputUsdPerMillion":1.25,"outputUsdPerMillion":4.25},"meta/muse-wonder-1.0":{"reservationUsd":0.25,"inputUsdPerMillion":4,"outputUsdPerMillion":20},"meta-asr/muse-voice-transcribe-1.0":{"reservationUsd":0.05,"inputUsdPerMillion":0,"outputUsdPerMillion":0}}'

# Server/process identity. The standalone worker sets its own role at launch.
HOST=127.0.0.1
NODE_ENV=development
IS_WORKER=false
ENABLE_DEMO_ACCOUNT=false
ENABLE_DEV_UPLOAD=false

# Local scratch/cache paths, relative to the engine root.
STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
SCRATCH_DIR=./storage/scratch
PROXY_CACHE_MAX_GB=10
# Optional executable paths; leave unset to use PATH/bundled installer.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Bounded provider requests. Limits are not measured progress or quality scores.
META_MAX_OUTPUT_TOKENS=4096
META_VIDEO_MAX_OUTPUT_TOKENS=8192
META_REQUEST_TIMEOUT_MS=30000
META_MAX_MEDIA_BYTES=33554432
META_MAX_REQUEST_BYTES=50331648
META_TRANSCRIPT_CHUNK_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=2

# Scenes and source preparation.
SCENE_THRESHOLD=0.3
SCENE_MAX_FRAMES=12
SCENE_MIN_SECONDS=0.5
TRANSCRIPT_CHUNK_SECONDS=150
STREAM_INDEX_SOURCE=true
INDEX_SMALL_FILE_CACHE_MB=8
INDEX_RANGE_TIMEOUT_MS=900000
WORKER_SCRATCH_MAX_MB=512
WORKER_CLIP_SOURCE_MAX_MB=256
WINDOWED_TRANSCRIPTION=false
WINDOWED_SCENE_PREPARATION=false

# Two preparation slots and three continuation slots.
GLOBAL_MAX_ACTIVE_JOBS=5
DEFAULT_USER_SLOTS=5
INTERACTIVE_RESERVED_SLOTS=1
FACTORY_INGEST_SLOTS=2
FACTORY_CONTINUATION_SLOTS=3
CONNECTOR_POLL_INTERVAL_SEC=120

# Retrieval and bounded inspection.
SEARCH_DEADLINE_MS=30000
SEARCH_INSPECTION_MAX_SECONDS=20
SEARCH_INSPECTION_MAX_MB=25
SEARCH_CLOUD_SOURCE_MAX_MB=16
SEARCH_CLOUD_TOTAL_MB=32
PEOPLE_CONVERSATION_MAX_CANDIDATES=3
LOCAL_EMBEDDING_TIMEOUT_MS=60000
LOCAL_EMBEDDING_IDLE_MS=300000
LOCAL_EMBEDDING_ALLOW_DOWNLOAD=false
LOCAL_EMBEDDING_USER_IDS=
META_EMBEDDING_THREADS=4
# META_EMBEDDING_PYTHON_PATH=/absolute/path/to/.venv-mms/bin/python

# Meta MMS speech. Setup creates the default platform-specific Python path.
MMS_CPU_THREADS=4
# MMS_PYTHON_BIN=/absolute/path/to/.venv-mms/bin/python
# MMS_CACHE_DIR=storage/voice-cache/mms

# No Gemini/Baseten/Whisper/MiniLM/YuNet/SFace credentials or weights required.
