# Optional TTS-only exception. Merge into .engine/.env; do not replace the full env.
# Core Meta guards and VOICE_CONVERSATION_MODE=meta-mms must remain enabled.
ALLOW_NON_META_TTS=true
VOICE_TTS_PROVIDER=gemini
GEMINI_VOICE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY
VOICE_TTS_MODEL=gemini-3.8-flash-tts
VOICE_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
VOICE_TTS_VOICE=Kore
# Merge (do not replace) these entries into AI_MODEL_PRICING_JSON:
# "google-speech/gemini-3.8-flash-tts":{"reservationUsd":0.25,"inputUsdPerMillion":0.5,"outputUsdPerMillion":9}
# "google-speech/gemini-3.8-flash-lite-tts":{"reservationUsd":0.25,"inputUsdPerMillion":0.5,"outputUsdPerMillion":6}
# Check current rates in your account. The cumulative budget/ledger remain shared.
# Disable by setting ALLOW_NON_META_TTS=false and VOICE_TTS_PROVIDER=mms.
